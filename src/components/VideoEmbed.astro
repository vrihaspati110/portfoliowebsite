---
interface Props {
  videoUrl: string;
  title: string;
  softwareTag: string;
  role?: string;
  client?: string;
  logline?: string;
  aspectBadge?: string;
  category?: string;
}

const { 
  videoUrl, 
  title, 
  softwareTag, 
  role, 
  client, 
  logline, 
  aspectBadge, 
  category 
} = Astro.props;
---

<article class="portfolio-card" data-category={category}>
  <div class="video-wrapper">
    <iframe 
      src={videoUrl} 
      title={title} 
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen>
    </iframe>
    {aspectBadge && <span class="aspect-badge">{aspectBadge}</span>}
  </div>
  <div class="card-details">
    <div class="title-group">
      <div class="title-row">
        <h3>{title}</h3>
        <span class="tag">{softwareTag}</span>
      </div>
      {(role || client) && (
        <p class="card-meta">
          {role && <span class="role">{role}</span>}
          {role && client && <span class="divider">/</span>}
          {client && <span class="client">{client}</span>}
        </p>
      )}
      {logline && <p class="card-logline">{logline}</p>}
    </div>
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .portfolio-card:hover {
    transform: translateY(-5px);
  }
  .portfolio-card.is-hidden {
    display: none;
  }
  .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .portfolio-card:hover .video-wrapper {
    box-shadow: 0 14px 35px var(--card-glow, rgba(10, 30, 226, 0.2));
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .aspect-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, 0.9);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.22rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: none;
    transition: border-color 0.3s ease, color 0.3s ease;
    text-transform: uppercase;
  }
  .portfolio-card:hover .aspect-badge {
    border-color: rgba(10, 30, 226, 0.6);
    color: #ffffff;
  }
  .card-details {
    display: flex;
    flex-direction: column;
  }
  .title-group {
    display: flex;
    flex-direction: column;
  }
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }
  .title-row h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--card-title-color, #111);
    font-family: 'Inter', sans-serif;
    line-height: 1.25;
    letter-spacing: -0.2px;
  }
  .tag {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--card-tag-color, #0a1ee2);
    font-family: 'Plus Jakarta Sans', sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
  .card-meta {
    margin: 0 0 0.35rem 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--card-meta-color, #606470);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .card-meta .divider {
    color: var(--card-tag-color, #0a1ee2);
    opacity: 0.6;
    font-weight: 700;
  }
  .card-logline {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--card-logline-color, #454852);
  }
</style>
