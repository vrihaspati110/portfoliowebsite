---
const { videoUrl, title, softwareTag } = Astro.props;
---

<article class="portfolio-card">
  <div class="video-wrapper">
    <iframe 
      src={videoUrl} 
      title={title} 
      frameborder="0" 
      allow="autoplay; fullscreen; picture-in-picture" 
      allowfullscreen>
    </iframe>
  </div>
  <div class="card-details">
    <div class="title-group">
      <h3>{title}</h3>
      <span class="tag">{softwareTag}</span>
    </div>
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    transition: transform 0.3s ease;
  }
  .portfolio-card:hover {
    transform: translateY(-5px);
  }
  .video-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
    overflow: hidden;
  }
  .video-wrapper iframe {
    width: 100%;
    height: 100%;
  }
  .card-details {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .title-group h3 {
    margin: 0 0 0.6rem 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #111;
    text-transform: uppercase;
    font-family: 'Inter', sans-serif;
  }
  .tag {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0011ff;
    font-family: 'Source Code Pro', monospace;
    text-transform: uppercase;
  }
</style>
