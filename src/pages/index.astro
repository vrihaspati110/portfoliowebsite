      </div>

      <ul class="nav-links">
        <li><a href="#work">Work</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="mailto:vrihaspatitiwari@proton.me" class="nav-cta">Contact</a></li>
      </ul>
    </nav>

    <!-- Hero Section -->
    <section class="hero section-padding">
      <div class="container">
        <span class="section-label">Post-Production</span>
        <h1 class="section-title">Film Editor & Sound Designer Based in India</h1>
        
        <div class="section-body-wrapper">
          <p class="section-body">
            I edit narrative fiction, commercial launch AVs, comedy podcasts, and documentary shorts — taking picture and sound from rough cut to final master.
