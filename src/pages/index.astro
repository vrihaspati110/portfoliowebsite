    <!-- Interactive Client-side Scripts -->
    <script>
      // Filter Bar Interaction
      const filterButtons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('#work .portfolio-card');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');

          cards.forEach(card => {
            const categories = (card.getAttribute('data-category') || '').split(' ');
            if (filter === 'all' || categories.includes(filter)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // Inquiry Form Submission (FormSubmit via AJAX with fallback)
      const inquiryForm = document.getElementById('inquiry-form') as HTMLFormElement | null;
      if (inquiryForm) {
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
        const btnSpinner = submitBtn?.querySelector('.btn-spinner') as HTMLElement | null;
        const successAlert = document.getElementById('form-success') as HTMLElement | null;
        const errorAlert = document.getElementById('form-error') as HTMLElement | null;

        inquiryForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (successAlert) successAlert.style.display = 'none';
          if (errorAlert) errorAlert.style.display = 'none';

          if (submitBtn) submitBtn.disabled = true;
          if (btnText) btnText.style.display = 'none';
          if (btnSpinner) btnSpinner.style.display = 'inline';

          const formData = new FormData(inquiryForm);
          const payload: Record<string, any> = {};
          formData.forEach((value, key) => {
            if (key !== '_honey') {
              payload[key] = value;
            }
          });

          try {
            const res = await fetch('https://formsubmit.co/ajax/vrihaspatitiwari@proton.me', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            const result = await res.json();
            if (res.ok && (result.success === 'true' || result.success === true)) {
              if (successAlert) successAlert.style.display = 'block';
              inquiryForm.reset();
            } else if (result.message && result.message.toLowerCase().includes('activate')) {
              if (successAlert) {
                successAlert.innerHTML = '<strong>Almost there:</strong> FormSubmit dispatched a one-time activation link to <code>vrihaspatitiwari@proton.me</code>. Please confirm it in your inbox once to activate incoming inquiries.';
                successAlert.style.display = 'block';
              }
            } else {
              throw new Error(result.message || 'Submission error');
            }
          } catch (err) {
            console.error('Inquiry form submission error:', err);
            if (errorAlert) errorAlert.style.display = 'block';
          } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (btnText) btnText.style.display = 'inline';
            if (btnSpinner) btnSpinner.style.display = 'none';
          }
        });
      }
    </script>

