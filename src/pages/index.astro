          </p>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All Projects <span class="filter-count">10</span></button>
          <button class="filter-btn" data-filter="narrative">Narrative & Commercial <span class="filter-count">4</span></button>
