    <meta name="twitter:image" content="/profile.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Source+Code+Pro:wght@400;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg-body: #08090c;
        --bg-surface: #0f1015;
        --bg-surface-elevated: #161820;
        --border-subtle: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.16);
        --blue: #2962ff;
        --blue-glow: rgba(41, 98, 255, 0.35);
        --text-primary: #f2f3f5;
        --text-secondary: #9ea3b0;
        --text-muted: #656a78;
        --font-head: 'Inter', sans-serif;
        --font-body: 'Source Code Pro', monospace;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-body);
        color: var(--text-primary);
        -webkit-font-smoothing: antialiased;
      }
      
      /* Global Layout Utilities */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      .section-padding {
        padding: 5.5rem 0;
      }
      
      /* Typography System */
      .section-label {
        font-family: var(--font-body);
        color: var(--blue);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1rem;
        display: block;
      }
      .section-title {
        font-family: var(--font-head);
        font-size: clamp(2.3rem, 4.5vw, 4.2rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.5px;
        color: var(--text-primary);
        margin: 0 0 1.75rem 0;
        max-width: 920px;
        overflow-wrap: break-word;
      }
      .section-body-wrapper {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 2.25rem;
      }
      .section-body {
        font-family: var(--font-body);
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--text-secondary);
        max-width: 650px;
        margin: 0;
      }
      .btn {
        font-family: var(--font-head);
        display: inline-block;
        padding: 1rem 2.25rem;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        letter-spacing: 1px;
        font-size: 0.85rem;
        transition: background 0.2s, transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn-blue {
        background: var(--blue);
        color: #fff;
        box-shadow: 0 6px 20px var(--blue-glow);
      }
      .btn-blue:hover {
        background: #1b4fe8;
        box-shadow: 0 8px 28px rgba(41, 98, 255, 0.5);
      }
      .btn-ghost {
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border-strong);
        margin-left: 1rem;
      }
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: #ffffff;
      }

      /* Hero Section (Cinema Ambient Backlight) */
      .hero {
        background: radial-gradient(ellipse 90% 55% at 50% -10%, rgba(41, 98, 255, 0.22), transparent 70%), var(--bg-body);
        border-bottom: 1px solid var(--border-subtle);
      }
      .hero-tc {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--blue);
        letter-spacing: 1.5px;
        margin-bottom: 0.75rem;
      }
      
      /* Top Sticky Navigation */
      nav {
        position: sticky;
        top: 0;
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.1rem 2rem;
        font-family: var(--font-head);
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.85rem;
        background: rgba(8, 9, 12, 0.88);
        backdrop-filter: blur(14px);
        color: #ffffff;
        border-bottom: 1px solid var(--border-subtle);
      }
      .nav-brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: #ffffff;
        text-decoration: none;
        letter-spacing: 0.5px;
        transition: opacity 0.2s ease;
      }
      .nav-brand:hover {
        opacity: 0.85;
      }
      .nav-brand .role {
        color: var(--text-muted);
        font-weight: 400;
      }
      .nav-availability {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-size: 0.75rem;
        background: rgba(255, 255, 255, 0.06);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        color: rgba(255, 255, 255, 0.95);
        letter-spacing: 0.3px;
        border: 1px solid var(--border-subtle);
      }
      .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #00ff66;
        box-shadow: 0 0 8px #00ff66;
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(0, 255, 102, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.8rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-links a {
        color: var(--text-secondary);
        text-decoration: none;
        letter-spacing: 0.5px;
        transition: color 0.2s ease;
      }
      .nav-links a:hover {
        color: #ffffff;
      }
      .nav-links .nav-cta {
        background: var(--blue);
        color: #ffffff;
        padding: 0.55rem 1.25rem;
        box-shadow: 0 4px 14px var(--blue-glow);
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }
      .nav-links .nav-cta:hover {
        background: #1b4fe8;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(41, 98, 255, 0.5);
      }

      /* Client & Collaboration Strip */
      .client-strip {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        padding: 1.1rem 0;
        font-family: var(--font-body);
        font-size: 0.82rem;
      }
      .client-strip-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .strip-label {
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 1.5px;
        font-size: 0.72rem;
      }
      .strip-items {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        color: var(--text-secondary);
        font-weight: 600;
        letter-spacing: 0.3px;
      }
      .strip-dot {
        color: var(--blue);
        font-weight: 800;
      }

      /* Portfolio Section & Filter Tabs */
      .portfolio {
        background: var(--bg-body);
      }
      .filter-bar {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin: 2rem 0 2.5rem 0;
      }
      .filter-btn {
        background: var(--bg-surface-elevated);
        border: 1px solid var(--border-subtle);
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.55rem 1.15rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        transition: all 0.2s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .filter-btn:hover {
        border-color: var(--blue);
        color: #ffffff;
      }
      .filter-btn.active {
        background: var(--blue);
        border-color: var(--blue);
        color: #ffffff;
        box-shadow: 0 4px 16px var(--blue-glow);
      }
      .filter-count {
        font-size: 0.72rem;
        opacity: 0.85;
      }
      .portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 3rem 2.5rem;
      }

      /* Capabilities Section (Darkroom Surface) */
      .services {
        background: var(--bg-surface);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
      }
      .service-list {
        list-style: none;
        padding: 0;
        margin: 2.5rem 0 0 0;
      }
      .service-list li {
        display: flex;
        align-items: flex-start;
        padding: 2.2rem 0;
        border-bottom: 1px solid var(--border-subtle);
      }
      .service-list li:first-child {
        border-top: 1px solid var(--border-subtle);
      }
      .service-number {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--blue);
        width: 105px;
        letter-spacing: 0.5px;
      }
      .service-content h3 {
        font-family: var(--font-head);
        font-size: 1.55rem;
        font-weight: 700;
        letter-spacing: -0.3px;
        color: var(--text-primary);
        margin: 0 0 0.6rem 0;
      }
      .service-content p {
        font-family: var(--font-body);
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
        max-width: 620px;
      }

      /* About Section */
      .about {
        background: var(--bg-body);
      }
      .about-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3.5rem;
        align-items: start;
        margin-top: 1.5rem;
      }
      .about-text .section-body {
        max-width: 100%;
        margin-bottom: 2rem;
      }
      .photo-frame {
        position: relative;
        width: 100%;
        overflow: hidden;
        border: 1px solid var(--border-strong);
        background: #000;
      }
      .about-image {
        width: 100%;
        height: auto;
        filter: grayscale(100%);
        transition: filter 0.4s ease, transform 0.4s ease;
        display: block;
      }
      .photo-frame:hover .about-image {
        filter: grayscale(0%);
        transform: scale(1.02);
      }
      .camera-hud {
        position: absolute;
        left: 0;
        right: 0;
        padding: 0.75rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-body);
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.9);
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
        pointer-events: none;
        letter-spacing: 0.8px;
        font-weight: 600;
      }
      .bottom-hud {
        top: auto;
        bottom: 0;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
      }
      .rec-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ff2222;
        box-shadow: 0 0 8px #ff2222;
        margin-right: 0.35rem;
        animation: recBlink 1.5s infinite;
      }
      @keyframes recBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }
      
      /* Quote Section */
      .quote {
        background: var(--bg-surface);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
        text-align: center;
        padding: 5rem 0;
      }
      .quote-text {
        font-family: var(--font-body);
        font-size: 1.4rem;
        line-height: 1.6;
        color: var(--text-primary);
        max-width: 800px;
        margin: 0 auto;
      }

      /* Footer Section */
      .site-footer {
        padding: 2.5rem 0;
        background-color: var(--bg-body);
      }
      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: var(--text-muted);
      }
      .contact-email {
        color: var(--text-primary);
        font-weight: 600;
        letter-spacing: 0.5px;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .contact-email:hover {
        color: var(--blue);
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .section-padding { padding: 3.5rem 0; }
        .quote { padding: 3.5rem 0; }
        nav {
          flex-direction: column;
          gap: 1rem;
          align-items: flex-start;
          padding: 1.2rem 1.5rem;
        }
        .nav-availability {
          display: none;
        }
        .nav-links {
          gap: 1rem;
          flex-wrap: wrap;
          font-size: 0.8rem;
        }
        .btn-ghost {
          margin-left: 0;
          margin-top: 0.75rem;
          display: block;
        }
        .client-strip-inner {
          flex-direction: column;
          align-items: flex-start;
        }
        .section-body-wrapper { justify-content: flex-start; margin-bottom: 1.5rem; }
        .service-list li { flex-direction: column; gap: 0.75rem; padding: 1.5rem 0; }
        .service-number { width: auto; }
        .portfolio-grid { grid-template-columns: 1fr; gap: 2rem; margin-top: 1.5rem; }
        .about-split {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .footer-content { 
          flex-direction: column-reverse; 
          gap: 1.2rem; 
          text-align: center; 
        }
      }
    </style>
  </head>
